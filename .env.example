# ==============================================================================
# Hybrid RAG with Web Fallback - Environment Variables
# ==============================================================================

# MongoDB Atlas Connection
# Required for vector and keyword hybrid search
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=rag_database
COLLECTION_NAME=rag_chunks

# Tavily Search API
# Required for automated live web search fallback
# Get your API key at: https://tavily.com/
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# LLM Providers (Configure at least one for generative streaming answers)
# Option 1: OpenAI (Default model: gpt-4o-mini)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Option 2: Google Gemini (Default model: gemini-1.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
